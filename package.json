{
  "name": "xray-mirror",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Real-time 3D anatomical X-ray overlay on the webcam, fully in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "anatomy": "node tools/build-anatomy.mjs",
    "models": "node tools/fetch-models.mjs",
    "test:e2e": "node tools/e2e.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/three": "0.187.0",
    "meshoptimizer": "1.3.0",
    "puppeteer-core": "25.18.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
